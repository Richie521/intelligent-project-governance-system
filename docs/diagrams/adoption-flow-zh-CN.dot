digraph "adoption-flow-zh-CN" {
  graph [rankdir=TB, splines=ortho, ordering=out, outputorder=edgesfirst, nodesep=0.46, ranksep=0.62, pad=0.36, bgcolor="#FFFFFF", fontname="Microsoft YaHei", fontsize=24, label=<<B>系统安装与落地</B>>, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#333333", fontcolor="#111111", fontname="Microsoft YaHei", fontsize=10, margin="0.22,0.15"];
  edge [color="#444444", fontname="Microsoft YaHei", fontsize=9, arrowsize=0.72, penwidth=1.1];

  start [label="下载候选包；在实际项目目录开启对话", shape=ellipse];
  entry [label="发送安装提示词；采用已知目录和选择"];
  intent [label="新项目、原地接入，还是迁入新目录？", shape=diamond, style=filled];

  subgraph cluster_new {
    label="新项目"; color="#888888"; style="rounded";
    new_entry [label="只建必要的本地入口"];
    new_work [label="新会话执行普通任务；核对入口已采用"];
    new_entry -> new_work;
  }
  subgraph cluster_existing {
    label="旧项目原地"; color="#888888"; style="rounded";
    existing_entry [label="原地基础接入；旧资料整理按需选择"];
    existing_history [label="有界资料逐项核验；缺原文则导出或记缺口"];
    existing_work [label="旧会话刷新当前入口；新会话普通工作"];
    existing_entry -> existing_history -> existing_work;
  }
  subgraph cluster_move {
    label="迁入新目录"; color="#888888"; style="rounded";
    move_guide [label="按需读取迁移说明；核实源、目标和依赖"];
    move_plan [label="逐项方案：保留能力、排除内容、恢复方式"];
    move_confirm [label="必要取舍确认；首次非空目标先停写"];
    move_copy [label="选择性复制并核对哈希；保留旧项目"];
    move_work [label="旧目录不可用时验证新目录功能；从新目录开会话"];
    move_guide -> move_plan -> move_confirm -> move_copy -> move_work;
  }

  inspect [label="查看实际文件、来源覆盖、冲突与工作结果"];
  recovery [label="失败或撤回：仅处理本轮创建且未变的内容", style="rounded,filled,dashed"];
  done [label="按实际证据报告完成、部分完成或阻断", shape=ellipse];

  start -> entry -> intent;
  intent -> new_entry [xlabel="新"];
  intent -> existing_entry [xlabel="原地"];
  intent -> move_guide [xlabel="迁移"];
  new_work -> inspect;
  existing_work -> inspect;
  move_work -> inspect;
  inspect -> done;
  inspect -> recovery [constraint=false, style=dashed, xlabel="失败或撤回"];
}
