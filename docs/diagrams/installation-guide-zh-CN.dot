digraph "installation-guide-zh-CN" {
  graph [
    rankdir=TB,
    splines=ortho,
    ordering=out,
    outputorder=edgesfirst,
    nodesep=0.34,
    ranksep=0.42,
    pad=0.28,
    bgcolor="#FFFFFF",
    fontname="Microsoft YaHei",
    fontsize=11,
    label="安装流程",
    labelloc=t
  ];
  node [fontname="Microsoft YaHei", fontsize=10, color="#282828", fontcolor="#202020", margin="0.20,0.14", style="rounded,filled", fillcolor="#FFFFFF"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#333333", arrowsize=0.7, penwidth=1.05];

  download [label="下载并解压预览版", shape=ellipse, style=filled];
  prompt [label="发送安装提示词；回答必要选择", shape=box];
  choice [label="选择基础接入或可选的\n旧资料整理", shape=diamond, style=filled, margin="0.12,0.08"];
  basic [label="基础：仅增补或适配本地入口；\n不读取历史资料", shape=box];
  scope [label="可选整理：选择有界的原生对话\n或导出材料", shape=box];
  inventory [label="逐项列出资料、来源、状态和去向；\n原始资料留在原处", shape=box];
  verify [label="核验资料覆盖；建立索引\n与本地入口路由", shape=box];
  files [label="检查本地文件；冲突或未完成项\n如实报告", shape=box];
  sessions [label="旧对话继续前核对当前入口；\n新对话从本地入口开始", shape=box];
  report [label="仅报告现有证据\n能够支持的结论", shape=ellipse, style=filled];

  { rank=same; basic; scope; }
  download -> prompt -> choice;
  choice -> basic [xlabel="基础接入"];
  choice -> scope [xlabel="整理资料"];
  scope -> inventory -> verify -> files;
  basic -> files;
  files -> sessions -> report;
}
